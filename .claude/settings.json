{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(*test:scenarios*)",
      "Bash(*test:ragas*)",
      "Bash(*test:evals*)",
      "Bash(*test:simulations*)",
      "Bash(*test-scenarios*)",
      "Bash(*test-ragas*)",
      "Bash(*test-evals*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-files.sh \"$FILE_PATH\"",
            "statusMessage": "Checking file protection..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-files.sh \"$FILE_PATH\"",
            "statusMessage": "Checking file protection..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-code.sh \"$FILE_PATH\"",
            "statusMessage": "Formatting code..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-code.sh \"$FILE_PATH\"",
            "statusMessage": "Formatting code..."
          }
        ]
      }
    ]
  }
}
