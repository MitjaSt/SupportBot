
# Filesystem
CACHE_DIR_JSON=".cache/json"
CACHE_DIR_FLAT=".cache/flat"
CACHE_DIR_SUMMARIES=".cache/summaries"
CACHE_DIR_CRITERIA=".cache/criteria"
CACHE_DIR_PROMPTS=".cache/prompts"

# Scraping
MAX_CONCURRENT_SCRAPES="5"

# Embedding Model
EMBEDDING_MODEL="embaas/sentence-transformers-gte-large"
EMBEDDING_VECTOR_SIZE="1024"

# RAG Retrieval Settings
RAG_TOP_K="2"
RAG_SCORE_THRESHOLD="0.7"
RAG_MAX_TOKENS="4096"
RAG_PROMPT_TOKEN_WARN_THRESHOLD="2000"
RAG_PROMPT_TOKEN_REJECT_THRESHOLD="4000"
RAG_CONTEXT_HISTORY_MESSAGES="3"

# Chunking Settings (for document processing)
CHUNKING_SIZE_TOKENS="256"
CHUNKING_OVERLAP_TOKENS="100"

# Remote LLM/API Keys
HUGGINGFACE_TOKEN=""
