# LangFuse
LANGFUSE_ENABLE=false
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

LANGFUSE_PROMPT_SUMMARY="mc-content-summarizer"
LANGFUSE_PROMPT_SYSTEM="mc-system-prompt"

# OpenAI
OPENAI_ENABLE=true
OPENAI_MODEL="gpt-5.2-chat-latest"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_API_KEY=""
OPENAI_ADMIN_KEY=""
OPENAI_TIMEOUT="120"

# LangWatch
LANGWATCH_ENABLE=false
LANGWATCH_API_KEY=""
LANGWATCH_PROMPT_SYSTEM="mc-system-prompt"
LANGWATCH_PROMPT_SUMMARY="mc-content-summarizer"

# ConfidentAI
CONFIDENTAI_ENABLE=false
CONFIDENTAI_API_KEY=""

# PostgreSQL with pgvector (replaces Qdrant + Redis)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DATABASE=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_SESSION_EXPIRY_HOURS="24"

# Vapi service
VAPI_PRIVATE_KEY=""
VAPI_PUBLIC_KEY=""
VAPI_ASSISTANT_ID=""

# Whisper STT Service
WHISPER_URL="http://localhost:3040"

# Piper TTS Service
PIPER_URL="http://localhost:3050"

# DockerHub
DOCKERHUB_REPO=""
DOCKERHUB_USERNAME=""
DOCKERHUB_PASSWORD=""

# Rate Limiting
# IP limit is a coarse flood-protection backstop. Keep it high because VPNs /
# corporate proxies make many real users share one IP. Per-user throttling is
# enforced separately by the session limit below.
RATE_LIMIT_IP_MAX="200"
RATE_LIMIT_IP_WINDOW_MS="60000"
# Per-session limit — the real per-user control (VPN-immune).
RATE_LIMIT_SESSION_MAX="20"
RATE_LIMIT_SESSION_WINDOW_MS="60000"