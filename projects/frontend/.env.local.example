# Admin app OIDC config — copy this file to .env.local and fill in the values.
# The client ID is printed at the end of docker/setup-zitadel.sh output ("Frontend app ... Client ID").
# .env.local is gitignored and must not be committed.

VITE_ZITADEL_ISSUER=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=<web_client_id_from_setup_script>
VITE_ZITADEL_REDIRECT_URI=http://localhost:5174/callback
VITE_ZITADEL_POST_LOGOUT_URI=http://localhost:5174
