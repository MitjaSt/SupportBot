{
  "name": "macular-society-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "rm -rf node_modules/.vite node_modules/.vite-admin",
    "dev": "vite",
    "dev:chat": "vite",
    "dev:admin": "vite --config vite.config.admin.ts",
    "build": "tsc && vite build && vite build --config vite.config.admin.ts",
    "build:chat": "tsc && vite build",
    "build:admin": "tsc && vite build --config vite.config.admin.ts",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "oidc-client-ts": "^3.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^15.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1"
  }
}
