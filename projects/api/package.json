{
  "name": "macular-society-api",
  "version": "1.0.0",
  "description": "RAG API for Macular Society - TypeScript/NestJS implementation",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "test:scenarios": "vitest run test/evals/scenarios/ --reporter=verbose",
    "test:ragas": "vitest run test/evals/ragas/ --reporter=verbose",
    "test:evals": "vitest run test/evals/ --reporter=verbose",
    "scrape": "ts-node -r tsconfig-paths/register scripts/scrape.ts",
    "test:generate": "ts-node -r tsconfig-paths/register scripts/generate-tests-from-criteria.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/serve-static": "^4.0.2",
    "@sinclair/typebox": "^0.32.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "chonkie": "^0.1.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.38.0",
    "js-yaml": "^4.1.1",
    "langfuse": "^3.38.6",
    "langwatch": "^0.13.0",
    "node-cache": "^5.1.2",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tiktoken": "^1.0.22",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.89",
    "@langwatch/scenario": "^0.4.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "ai": "^5.0.129",
    "deepeval-ts": "^0.1.14",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.0.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
