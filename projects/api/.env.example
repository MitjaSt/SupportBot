# This TypeScript project uses the same .env file as the Python project
# Copy from parent directory: cp ../.env .env
# Or the config will automatically load from ../.env

# Override these for OpenAI embeddings
OPENAI_ENABLE=true
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_SIZE=1536
