# Filesystem
CACHE_DIR_JSON=".cache/json"
CACHE_DIR_FLAT=".cache/flat"
CACHE_DIR_SUMMARIES=".cache/summaries"
CACHE_DIR_CRITERIA=".cache/criteria"
CACHE_DIR_PROMPTS=".cache/prompts"

# Scraping
MAX_CONCURRENT_SCRAPES="10"
RAG_HYBRID_SEARCH_ENABLED=true
FOLLOWUP_SUGGESTIONS_ENABLED=true

# Embedding Model
EMBEDDING_MODEL="embaas/sentence-transformers-gte-large"
EMBEDDING_VECTOR_SIZE="1024"

# RAG Retrieval Settings
RAG_TOP_K="3"
RAG_SCORE_THRESHOLD="0.4"
RAG_MAX_TOKENS="4096"
RAG_PROMPT_TOKEN_WARN_THRESHOLD="2000"
RAG_PROMPT_TOKEN_REJECT_THRESHOLD="4000"
RAG_CONTEXT_HISTORY_MESSAGES="3"

# Chunking Settings (for document processing)
CHUNKING_SIZE_TOKENS="256"
CHUNKING_OVERLAP_TOKENS="100"

# LangFuse
LANGFUSE_ENABLE=false
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_PROMPT_SUMMARY="ContentSummarizer"
LANGFUSE_PROMPT_SYSTEM="macular-society-system-prompt"

# OpenAI
OPENAI_ENABLE=true
OPENAI_MODEL="gpt-5-chat-latest"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TIMEOUT=120

# LangWatch
LANGWATCH_ENABLE=true
LANGWATCH_PROMPT_SYSTEM="macular-society-system-prompt"
LANGWATCH_PROMPT_SUMMARY="mc-content-summarizer"

# ConfidentAI
CONFIDENTAI_ENABLE=false

# DockerHub
DOCKERHUB_REPO="mitjast/rag_test"

# PostgreSQL with pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=macular_society
POSTGRES_SESSION_EXPIRY_HOURS="24"

# ElevenLabs
ELEVENLABS_VOICE_ID="SAz9YHcvj6GT2YYXdXww"

# Vapi service
VAPI_ASSISTANT_ID="271595a7-5a7a-4847-b9fc-67621e5208f2"

# Whisper STT Service
WHISPER_URL="http://localhost:3040"

# Piper TTS Service
PIPER_URL="http://localhost:3050"

# Rate Limiting
RATE_LIMIT_IP_MAX="200"
RATE_LIMIT_IP_WINDOW_MS="60000"
RATE_LIMIT_SESSION_MAX="20"
RATE_LIMIT_SESSION_WINDOW_MS="60000"

# Sentry
SENTRY_ENABLE=false
SENTRY_RELEASE="dev"
SENTRY_TRACES_SAMPLE_RATE="0"

# PromptGuard — prompt injection / jailbreak detection (self-hosted sidecar)
PROMPT_GUARD_ENABLE=false
PROMPT_GUARD_URL="http://localhost:8002"

# Confluence / Jira integration
CONFLUENCE_BASE_URL="https://mitjastepan-1773192337467.atlassian.net"
CONFLUENCE_SPACE_KEY="~5570582136700a371d4122bb28f0181ecfb0d6"
CONFLUENCE_ACCOUNT_EMAIL="mitja.stepan@gmail.com"
CONFLUENCE_BOT_ACCOUNT_ID="557058:2136700a-371d-4122-bb28-f0181ecfb0d6"
JIRA_BASE_URL="https://mitjastepan-1773192337467.atlassian.net"

# Zitadel auth — set AUTH_ENABLED=true once Zitadel is running.
# Chat routes stay public; optional token grants debug chunks (system:read).
AUTH_ENABLED=true
ZITADEL_JWKS_URI="http://localhost:8080/oauth/v2/keys"
ZITADEL_ISSUER="http://localhost:8080"
ZITADEL_AUDIENCE=363257710227030018
